{
    "appName": "connector_sovity",
    "version": "16.6.2-b.1",
    "name": "Connector Sovity",
    "architectures": "x86_64,aarch64",
    "type": "marketplace",
    "releaseNotes": [
        "Upgrade Sovity EDC Community Edition to 16.6.2 (connector and UI).",
        "DSP protocol path changed to /api/v1/dsp (Tractus-X alignment).",
        "Requires a fresh database: v16 migration history is incompatible with v15.",
        "Sovity 16.6.2 changelog: https://github.com/sovity/edc-ce/blob/main/CHANGELOG.md"
    ],
    "templateAppconfig": {},
    "uris": [
        {
            "name": "Sovity Management Web UI",
            "serviceName": "sovity-edc-ui",
            "pattern": "http://<IP>:<ports:SOVITY_UI_API_PORT>",
            "link": true
        },
        {
            "name": "Management API",
            "serviceName": "sovity-edc",
            "pattern": "http://<IP>:<ports:SOVITY_MANAGEMENT_API_PORT>/api/management",
            "link": false
        },
        {
            "name": "DSP Protocol API",
            "serviceName": "sovity-edc",
            "pattern": "http://<IP>:<ports:SOVITY_DATASPACE_API_PORT>/api/v1/dsp",
            "link": false
        }
    ],
    "services": [
        {
            "name": "sovity-edc-ui",
            "ports": [
                {
                    "description": "Sovity Web UI Port",
                    "name": "SOVITY_UI_API_PORT",
                    "type": "text",
                    "readableName": "Sovity Ui Api Port",
                    "default": "8080",
                    "mandatory": false,
                    "regex": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5]?[0-9]{1,4}|0)$"
                }
            ],
            "volumes": [],
            "env": [
                {
                    "description": "Sovity Management Api Url",
                    "name": "NEXT_PUBLIC_MANAGEMENT_API_URL",
                    "type": "text",
                    "readableName": "Next Public Management Api Url",
                    "default": "http://localhost:11002/api/management",
                    "mandatory": true,
                    "regex": "^https?:\\/\\/[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:\\/.*)?$"
                },
                {
                    "description": "Sovity Management Api Key",
                    "name": "NEXT_PUBLIC_MANAGEMENT_API_KEY",
                    "type": "text",
                    "readableName": "Next Public Management Api Key",
                    "default": "demo-api-key",
                    "mandatory": true,
                    "regex": "^.{1,256}$"
                },
                {
                    "description": "Sovity Protocol Api Url",
                    "name": "NEXT_PUBLIC_PROTOCOL_API_URL",
                    "type": "text",
                    "readableName": "Next Public Protocol Api Url",
                    "default": "http://localhost:11003/api/v1/dsp",
                    "mandatory": true,
                    "regex": "^https?:\\/\\/[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:\\/.*)?$"
                },
                {
                    "description": "Sovity Preconfigured Counterparties (JSON array of URLs)",
                    "name": "NEXT_PUBLIC_PRECONFIGURED_COUNTERPARTIES",
                    "type": "text",
                    "readableName": "Next Public Preconfigured Counterparties",
                    "default": "[\"http://localhost:11003/api/v1/dsp?participantId=odeon\"]",
                    "mandatory": true,
                    "regex": "^\\[\\s*\"https?:\\/\\/[^\"\\]]+\"(\\s*,\\s*\"https?:\\/\\/[^\"\\]]+\")*\\s*\\]$"
                }
            ]
        },
        {
            "name": "sovity-edc",
            "ports": [
                {
                    "description": "Sovity Management Api Port",
                    "name": "SOVITY_MANAGEMENT_API_PORT",
                    "type": "text",
                    "readableName": "Sovity Management Api Port",
                    "default": "11002",
                    "mandatory": false,
                    "regex": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5]?[0-9]{1,4}|0)$"
                },
                {
                    "description": "Sovity Dataspace Api Port",
                    "name": "SOVITY_DATASPACE_API_PORT",
                    "type": "text",
                    "readableName": "Sovity Dataspace Api Port",
                    "default": "11003",
                    "mandatory": false,
                    "regex": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5]?[0-9]{1,4}|0)$"
                }
            ],
            "volumes": [],
            "env": [
                {
                    "description": "Sovity type of deployment",
                    "name": "SOVITY_DEPLOYMENT_KIND",
                    "type": "text",
                    "readableName": "Sovity Deployment Kind",
                    "default": "control-plane-with-integrated-data-plane",
                    "mandatory": true,
                    "regex": "^(control-plane-with-integrated-data-plane|control-plane-standalone|data-plane-standalone|e2e-test-backend)$"
                },
                {
                    "description": "Sovity dataspace kind to use",
                    "name": "SOVITY_DATASPACE_KIND",
                    "type": "text",
                    "readableName": "Sovity Dataspace Kind",
                    "default": "sovity-mock-iam",
                    "mandatory": true,
                    "regex": "^(sovity-mock-iam|sovity-daps|sovity-daps-omejdn|catena-x|railway-x)$"
                },
                {
                    "description": "Sovity Management Api Iam Kind",
                    "name": "SOVITY_MANAGEMENT_API_IAM_KIND",
                    "type": "text",
                    "readableName": "Sovity Management Api Iam Kind",
                    "default": "management-iam-api-key",
                    "mandatory": true,
                    "regex": "^(management-iam-api-key)$"
                },
                {
                    "description": "Sovity Edc Api Auth Key",
                    "name": "EDC_API_AUTH_KEY",
                    "type": "text",
                    "readableName": "Edc Api Auth Key",
                    "default": "demo-api-key",
                    "mandatory": true,
                    "regex": "^.{1,256}$"
                },
                {
                    "description": "Sovity Edc Participant Id",
                    "name": "EDC_PARTICIPANT_ID",
                    "type": "text",
                    "readableName": "Edc Participant Id",
                    "default": "odeon",
                    "mandatory": true,
                    "regex": "^[A-Za-z0-9._-]{1,64}$"
                },
                {
                    "description": "Sovity Edc Component Id",
                    "name": "EDC_COMPONENT_ID",
                    "type": "text",
                    "readableName": "Edc Component Id",
                    "default": "odeon-control",
                    "mandatory": true,
                    "regex": "^[A-Za-z0-9._-]{1,64}$"
                },
                {
                    "description": "Sovity Edc FQDN Internal (docker service name)",
                    "name": "SOVITY_EDC_FQDN_INTERNAL",
                    "type": "text",
                    "readableName": "Sovity Edc Fqdn Internal",
                    "default": "sovity-edc",
                    "mandatory": true,
                    "regex": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                },
                {
                    "description": "Sovity Edc FQDN Public (hostname or IPv4)",
                    "name": "SOVITY_EDC_FQDN_PUBLIC",
                    "type": "text",
                    "readableName": "Sovity Edc Fqdn Public",
                    "default": "localhost",
                    "mandatory": true,
                    "regex": "^(([A-Za-z0-9-]+\\.)*[A-Za-z0-9-]+|(\\d{1,3}\\.){3}\\d{1,3})$"
                },
                {
                    "description": "Sovity Edc CORS Enabled",
                    "name": "EDC_WEB_REST_CORS_ENABLED",
                    "type": "boolean",
                    "readableName": "Edc Web Rest Cors Enabled",
                    "default": "true",
                    "mandatory": true,
                    "regex": ""
                },
                {
                    "description": "Sovity Edc CORS Origins (comma-separated origins)",
                    "name": "EDC_WEB_REST_CORS_ORIGINS",
                    "type": "text",
                    "readableName": "Edc Web Rest Cors Origins",
                    "default": "http://localhost:8080",
                    "mandatory": true,
                    "regex": "^https?:\\/\\/[^,\\s]+(?:,\\s*https?:\\/\\/[^,\\s]+)*$"
                },
                {
                    "description": "Sovity Edc CORS Methods (comma-separated)",
                    "name": "EDC_WEB_REST_CORS_METHODS",
                    "type": "text",
                    "readableName": "Edc Web Rest Cors Methods",
                    "default": "GET,POST,PUT,DELETE,PATCH,OPTIONS",
                    "mandatory": true,
                    "regex": "^(?:GET|POST|PUT|DELETE|PATCH|OPTIONS)(?:,(?:GET|POST|PUT|DELETE|PATCH|OPTIONS))*$"
                },
                {
                    "description": "Sovity Edc CORS Headers (comma-separated; '*' allowed)",
                    "name": "EDC_WEB_REST_CORS_HEADERS",
                    "type": "text",
                    "readableName": "Edc Web Rest Cors Headers",
                    "default": "*,x-api-key,authorization,content-type",
                    "mandatory": true,
                    "regex": "^\\*(?:,[A-Za-z0-9-]+)*$"
                },
                {
                    "description": "Sovity Edc CORS Credentials",
                    "name": "EDC_WEB_REST_CORS_CREDENTIALS",
                    "type": "boolean",
                    "readableName": "Edc Web Rest Cors Credentials",
                    "default": "false",
                    "mandatory": true,
                    "regex": ""
                }
            ]
        },
        {
            "name": "postgresql",
            "ports": [],
            "volumes": [
                {
                    "description": "Named Docker volume for PostgreSQL persistent data.",
                    "name": "VOLUME_SOVITY_DB_DATA",
                    "type": "text",
                    "readableName": "Sovity Database Data Volume",
                    "default": "sovity-db-data",
                    "mandatory": true,
                    "regex": "^[a-zA-Z0-9_-]+$"
                }
            ],
            "env": []
        }
    ],
    "marketDescription": {
        "categories": [],
        "developer": "Barbara IoT",
        "docker": true,
        "longDesc": "Sovity EDC Community Edition (v16.6.2) packaged as a Barbara Marketplace connector. Deploys an Eclipse Dataspace Components (EDC) connector with an integrated control and data plane plus a Next.js management web UI, enabling the edge device to publish, discover, negotiate and exchange data within a federated data space with policy-based governance. Exposes a Management API and a DSP protocol API (/api/v1/dsp), and bundles a PostgreSQL database for persistence.",
        "shortDesc": "Sovity EDC dataspace connector with management web UI."
    }
}
