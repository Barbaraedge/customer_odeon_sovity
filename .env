# --- Host ports ---
# Read by Compose to interpolate the "ports:" mappings in the compose file,
# and passed into the containers along with everything else below.

SOVITY_MANAGEMENT_API_PORT=11002
SOVITY_DATASPACE_API_PORT=11003
SOVITY_UI_API_PORT=8080

# --- Runtime profile ---

SOVITY_DEPLOYMENT_KIND=control-plane-with-integrated-data-plane

# --- Dataspace profile (local/demo) ---

SOVITY_DATASPACE_KIND=sovity-mock-iam

# --- Management API auth ---

SOVITY_MANAGEMENT_API_IAM_KIND=management-iam-api-key
EDC_API_AUTH_KEY=demo-api-key

# --- Identity / names ---

EDC_PARTICIPANT_ID=odeon
EDC_COMPONENT_ID=odeon-control

# --- FQDNs (no scheme/port) ---

SOVITY_EDC_FQDN_INTERNAL=sovity-edc
SOVITY_EDC_FQDN_PUBLIC=localhost

# --- Database ---
# The database credentials (POSTGRES_* and SOVITY_JDBC_*) are internal wiring
# and are embedded directly in the compose file, not operator-configurable.

NEXT_PUBLIC_MANAGEMENT_API_URL=http://localhost:11002/api/management
NEXT_PUBLIC_MANAGEMENT_API_KEY=demo-api-key
NEXT_PUBLIC_PROTOCOL_API_URL=http://localhost:11003/api/v1/dsp
NEXT_PUBLIC_PRECONFIGURED_COUNTERPARTIES=["http://localhost:11003/api/v1/dsp?participantId=odeon"]

EDC_WEB_REST_CORS_ENABLED=true
EDC_WEB_REST_CORS_ORIGINS=http://localhost:8080
EDC_WEB_REST_CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
EDC_WEB_REST_CORS_HEADERS=*,x-api-key,authorization,content-type
EDC_WEB_REST_CORS_CREDENTIALS=false
